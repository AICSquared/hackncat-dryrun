# Copy to .env.local for local work, and add the same values in Vercel > Settings > Environment Variables.

# Supabase > Project Settings > API (use the publishable and secret keys; the legacy anon and service_role names also work)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional Render worker. Leave blank to run background work inside Next.js.
RENDER_SERVICE_URL=
RENDER_INTERNAL_SECRET=
